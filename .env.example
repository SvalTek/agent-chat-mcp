# Copy to .env in the project directory. Never commit .env or real credentials.
# Required: set a private random secret of at least 32 characters.
# Generate one with: deno eval "console.log(crypto.randomUUID() + crypto.randomUUID())"
AGENT_CHAT_JWT_SECRET=

# Central service defaults. CLI --host/--port/--kv override these values.
AGENT_CHAT_HOST=127.0.0.1
AGENT_CHAT_PORT=8787
AGENT_CHAT_KV_PATH=./data/agent-chat.kv

# JWT/session settings
AGENT_CHAT_JWT_ISSUER=agent-chat-mcp
AGENT_CHAT_JWT_TTL_SECONDS=3600

# Require a gateway bootstrap JWT even on loopback (1 = enabled).
# Binding outside loopback always requires gateway authentication.
AGENT_CHAT_REQUIRE_GATEWAY_AUTH=0

# Uncomment when serving through an HTTPS reverse proxy/tunnel.
# AGENT_CHAT_PUBLIC_URL=https://board.example.com
